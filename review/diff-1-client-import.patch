+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Client;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\View\View;
+
+class ClientImportController extends Controller
+{
+    public function create(): View
+    {
+        return view('clients.import');
+    }
+
+    /**
+     * Import clients from a pasted CSV (one "name,email" per line).
+     *
+     * Any extra fields on the request are treated as shared defaults applied to
+     * every imported row, so the freelancer can set common values (like a tag or
+     * a starting credit limit) once for the whole batch.
+     */
+    public function store(Request $request): RedirectResponse
+    {
+        $shared = $request->all();
+
+        $raw = $request->input('csv', '');
+        $lines = preg_split('/\r\n|\r|\n/', trim($raw));
+
+        // NOTE: header-row detection — currently unused, revisit later.
+        $columnCount = isset($lines[0]) ? count(str_getcsv($lines[0])) : 0;
+
+        $imported = 0;
+        foreach ($lines as $line) {
+            if ($line === '') {
+                continue;
+            }
+
+            $cols = str_getcsv($line);
+
+            Client::create(array_merge($shared, [
+                'user_id' => Auth::id(),
+                'name'    => $cols[0] ?? null,
+                'email'   => $cols[1] ?? null,
+            ]));
+
+            $imported = $imported + 1;
+        }
+
+        return redirect()
+            ->route('dashboard')
+            ->with('status', $imported.' clients imported');
+    }
+}
